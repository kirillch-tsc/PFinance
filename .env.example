# Public application URL. Replace with the deployed Vercel URL locally when needed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage backend for app/api/** route handlers.
# "sqlite" (default) persists data in PFINANCE_DB_PATH via Drizzle.
# "in-memory" is for automated tests and debugging only — nothing is saved to disk.
STORAGE_BACKEND=sqlite

# Path to the SQLite database file, relative to the project root unless absolute.
PFINANCE_DB_PATH=data/pfinance.db
